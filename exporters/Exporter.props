<Project>
  <!-- Shared by the Game Adapter projects. Game, Unity and BepInEx assemblies come from a local game
       install (ADR 0007): set KKBP_GAMES_DIR, or keep the installs in the working copy's games/ folder.
       Nothing from an install is copied into the build output. -->
  <PropertyGroup>
    <!-- The KKBP Version (YYYY.MM.DD) is in the repository's VERSION file, shared with the importer
         (ADR 0060). The Manifest and the window title record it as written. BepInEx needs numbers
         without leading zeros, so the plugin version is the same date parsed (2027.01.05 -> 2027.1.5). -->
    <KKBPExporterVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</KKBPExporterVersion>
    <KKBPPluginVersion>$([System.Version]::Parse('$(KKBPExporterVersion)').ToString())</KKBPPluginVersion>
    <KKBPGamesDir Condition="'$(KKBPGamesDir)' == '' And '$(KKBP_GAMES_DIR)' != ''">$(KKBP_GAMES_DIR)</KKBPGamesDir>
    <KKBPGamesDir Condition="'$(KKBPGamesDir)' == ''">$(MSBuildThisFileDirectory)..\games</KKBPGamesDir>
    <KKBPGamesDir>$([MSBuild]::EnsureTrailingSlash('$(KKBPGamesDir)'))</KKBPGamesDir>
    <KKBPContractDir>$(MSBuildThisFileDirectory)..\contract\</KKBPContractDir>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Each adapter adds its game's assemblies to GameAssembly, with paths relative to KKBPGamesDir. -->
  <Target Name="KKBPReferenceGameAssemblies" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(KKBPGamesDir)%(GameAssembly.Identity)')"
           Text="Missing game assembly $(KKBPGamesDir)%(GameAssembly.Identity). Install the game there, or set KKBP_GAMES_DIR to the folder holding the installs (ADR 0007)." />
    <ItemGroup>
      <Reference Include="@(GameAssembly->'%(Filename)')">
        <HintPath>$(KKBPGamesDir)%(GameAssembly.Identity)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="KKBPWriteVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <KKBPVersionFile>$(IntermediateOutputPath)ExporterVersion.g.cs</KKBPVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(KKBPVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace KKBP.Exporter { internal static class ExporterVersion { public const string Value = &quot;$(KKBPExporterVersion)&quot;%3B public const string Plugin = &quot;$(KKBPPluginVersion)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(KKBPVersionFile)" />
      <FileWrites Include="$(KKBPVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
