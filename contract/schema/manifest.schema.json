{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kkbp.invalid/1.3/manifest.schema.json",
  "title": "manifest.json",
  "description": "Identifies an Export Bundle. Written last; a bundle without one is an unfinished export.",
  "type": "object",
  "properties": {
    "game": { "$ref": "common.schema.json#/$defs/game" },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "exporter": {
      "description": "Informational only; never used to accept or reject a bundle.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "exported_at": {
      "description": "RFC 3339 time in UTC.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "character_name": { "type": "string" },
    "card": {
      "oneOf": [
        { "const": "card.png" },
        { "type": "null" }
      ]
    },
    "options": {
      "description": "The export options used.",
      "type": "object",
      "properties": {
        "all_outfits": { "type": "boolean" },
        "all_variations": { "type": "boolean" },
        "physics": { "type": "boolean" },
        "enabled_shape_keys": { "type": "boolean" },
        "current_pose": { "type": "boolean" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      },
      "required": ["all_outfits", "all_variations", "physics", "enabled_shape_keys", "current_pose"],
      "additionalProperties": false
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": { "const": "body" },
              "outfit": { "type": "null" },
              "mesh": { "const": "body.glb" },
              "data": { "const": "body.json" }
            },
            "required": ["kind", "outfit", "mesh", "data"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "const": "outfit" },
              "outfit": { "$ref": "common.schema.json#/$defs/outfit_index" },
              "mesh": { "type": "string", "pattern": "^outfits/[0-9]{2}/outfit\\.glb$" },
              "data": { "type": "string", "pattern": "^outfits/[0-9]{2}/outfit\\.json$" }
            },
            "required": ["kind", "outfit", "mesh", "data"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["game", "schema_version", "exporter", "exported_at", "character_name", "card", "options", "passes"],
  "additionalProperties": false
}
